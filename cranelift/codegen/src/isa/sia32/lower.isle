;; Initial SIA32 CLIF-to-MachInst lowering.
;;
;; This deliberately starts with the integer leaf-function core. Unsupported
;; CLIF operations continue to fail through Cranelift's normal "should be
;; implemented in ISLE" path rather than being approximated.

(decl partial lower (Inst) InstOutput)
(decl partial lower_branch (Inst MachLabelSlice) Unit)

;; Emit one result-producing instruction.
(decl sia_emit_result (MInst WritableReg) InstOutput)
(rule (sia_emit_result inst dst)
      (let ((_ Unit (emit inst)))
        (output (value_reg (writable_reg_to_reg dst)))))

;;;; Constants ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (iconst (fits_in_32 (ty_int ty)) (u64_from_imm64 n)))
      (let ((dst WritableReg (temp_writable_reg ty)))
        (sia_emit_result (sia_load_const dst n) dst)))

;;;; Integer ALU ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (iadd (fits_in_32 (ty_int ty)) x y))
      (let ((dst WritableReg (temp_writable_reg ty))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_add dst lhs rhs) dst)))

(rule (lower (isub (fits_in_32 (ty_int ty)) x y))
      (let ((dst WritableReg (temp_writable_reg ty))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_sub dst lhs rhs) dst)))

(rule (lower (band (fits_in_32 (ty_int ty)) x y))
      (let ((dst WritableReg (temp_writable_reg ty))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_and dst lhs rhs) dst)))

(rule (lower (bor (fits_in_32 (ty_int ty)) x y))
      (let ((dst WritableReg (temp_writable_reg ty))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_or dst lhs rhs) dst)))

(rule (lower (bxor (fits_in_32 (ty_int ty)) x y))
      (let ((dst WritableReg (temp_writable_reg ty))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_xor dst lhs rhs) dst)))

;; Variable shifts are initially restricted to I32. SIA masks the hardware
;; shift count to five bits; accepting I8/I16 here without explicit masking
;; would not implement CLIF's narrower-width semantics for all counts.
(rule (lower (ishl $I32 x y))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_shl dst lhs rhs) dst)))

(rule (lower (ushr $I32 x y))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_shr dst lhs rhs) dst)))

(rule (lower (sshr $I32 x y))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_sar dst lhs rhs) dst)))

(rule (lower (clz $I32 x))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (src Reg (put_in_reg x)))
        (sia_emit_result (sia_clz dst src) dst)))

(rule (lower (ctz $I32 x))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (src Reg (put_in_reg x)))
        (sia_emit_result (sia_ctz dst src) dst)))

(rule (lower (popcnt $I32 x))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (src Reg (put_in_reg x)))
        (sia_emit_result (sia_popcnt dst src) dst)))

;;;; Extension / reduction ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl sia_extend_result (Value bool u8) InstOutput)
(rule (sia_extend_result src signed from_bits)
      (let ((dst WritableReg (temp_writable_reg $I32))
            (reg Reg (put_in_reg src)))
        (sia_emit_result (sia_extend dst reg signed from_bits 32) dst)))

(rule (lower (uextend $I32 x @ (value_type $I8)))
      (sia_extend_result x false 8))
(rule (lower (uextend $I32 x @ (value_type $I16)))
      (sia_extend_result x false 16))
(rule (lower (sextend $I32 x @ (value_type $I8)))
      (sia_extend_result x true 8))
(rule (lower (sextend $I32 x @ (value_type $I16)))
      (sia_extend_result x true 16))

;; Reduction needs no machine instruction: the destination observes the low
;; bits of the same 32-bit register representation.
(rule (lower (ireduce $I8 x @ (value_type $I32))) (output_value x))
(rule (lower (ireduce $I16 x @ (value_type $I32))) (output_value x))


;;;; Dynamic stack allocation ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Runtime allocation grows the SIA32 stack downward. The generic IR operation
;; deliberately hides architectural r13 from language frontends.
(rule (lower (stack_alloc_dynamic $I32 size))
      (let ((saved WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_m_gpr_read saved 13)))
            (amount Reg (put_in_reg size))
            (next WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_sub next (writable_reg_to_reg saved) amount)))
            (_ Unit (emit (sia_m_gpr_write (writable_reg_to_reg next) 13))))
        (output (value_reg (writable_reg_to_reg next)))))

;;;; Stack addresses ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; stack_addr is an ABI pseudo: keep the stack-slot identity until post-regalloc
;; emission, where the finalized frame layout determines the SP-relative offset.
(rule (lower (stack_addr $I32 ss offset))
      (output (value_reg (gen_stack_addr ss offset))))

;;;; Scalar memory ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl sia_load_result (Type Value i32) InstOutput)
(rule (sia_load_result ty addr offset)
      (let ((dst WritableReg (temp_writable_reg ty))
            (base Reg (put_in_reg addr)))
        (sia_emit_result (sia_load_offset dst base offset ty) dst)))

(rule (lower (load (fits_in_32 (ty_int ty)) (little_or_native_endian _) addr (offset32 offset)))
      (sia_load_result ty addr offset))

(rule (lower (store (little_or_native_endian _) src @ (value_type (fits_in_32 (ty_int ty))) addr (offset32 offset)))
      (let ((value Reg (put_in_reg src))
            (base Reg (put_in_reg addr)))
        (side_effect (SideEffectNoResult.Inst (sia_store_offset value base offset ty)))))

;;;; Calls ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (call (func_ref_data sig_ref name _ patchable) args))
      (let ((output ValueRegsVec (gen_call_output sig_ref))
            (abi Sig (abi_sig sig_ref))
            (uses CallArgList (gen_call_args abi args))
            (defs CallRetList (gen_call_rets abi output))
            (info BoxCallInfo (gen_call_info abi name uses defs (try_call_none) patchable))
            (_ Unit (emit_side_effect (call_impl info))))
        output))

(rule (lower (call_indirect sig_ref ptr args))
      (let ((output ValueRegsVec (gen_call_output sig_ref))
            (abi Sig (abi_sig sig_ref))
            (target Reg (put_in_reg ptr))
            (uses CallArgList (gen_call_args abi args))
            (defs CallRetList (gen_call_rets abi output))
            (info BoxCallIndInfo (gen_call_ind_info abi target uses defs (try_call_none)))
            (_ Unit (emit_side_effect (call_ind_impl info))))
        output))


;;;; SIA32-P privileged operations ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(rule (lower (sia_trap (u8_from_uimm8 code)))
      (side_effect (SideEffectNoResult.Inst (sia_m_trap code))))
(rule (lower (sia_gpr_read $I32 (u8_from_uimm8 register)))
      (let ((dst WritableReg (temp_writable_reg $I32)))
        (sia_emit_result (sia_m_gpr_read dst register) dst)))
(rule (lower (sia_gpr_write value (u8_from_uimm8 register)))
      (let ((src Reg (put_in_reg value)))
        (side_effect (SideEffectNoResult.Inst (sia_m_gpr_write src register)))))
(rule (lower (sia_sread $I32 (u8_from_uimm8 selector)))
      (let ((dst WritableReg (temp_writable_reg $I32)))
        (sia_emit_result (sia_m_sread dst selector) dst)))
(rule (lower (sia_swrite value (u8_from_uimm8 selector)))
      (let ((src Reg (put_in_reg value)))
        (side_effect (SideEffectNoResult.Inst (sia_m_swrite src selector)))))
(rule (lower (sia_sret))
      (side_effect (SideEffectNoResult.Inst (sia_m_sret))))
(rule (lower (sia_tlbfence))
      (side_effect (SideEffectNoResult.Inst (sia_m_tlbfence))))
(rule (lower (sia_tlbfence_va value))
      (let ((src Reg (put_in_reg value)))
        (side_effect (SideEffectNoResult.Inst (sia_m_tlbfence_va src)))))
(rule (lower (sia_tlbfence_asid value))
      (let ((src Reg (put_in_reg value)))
        (side_effect (SideEffectNoResult.Inst (sia_m_tlbfence_asid src)))))
(rule (lower (sia_wfi))
      (side_effect (SideEffectNoResult.Inst (sia_m_wfi))))
(rule (lower (sia_sync_i))
      (side_effect (SideEffectNoResult.Inst (sia_m_sync_i))))

;;;; Return and control flow ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; The ABI generates the Rets pseudo and architectural RET.
(rule (lower (return args))
      (lower_return args))

(rule (lower_branch (jump _) (single_target target))
      (emit_side_effect (SideEffectNoResult.Inst (sia_jump target))))

(rule (lower_branch (brif cond _ _) (two_targets taken not_taken))
      (let ((test Reg (put_in_reg cond)))
        (emit_side_effect (SideEffectNoResult.Inst (sia_brnz test taken not_taken)))))

;; SIA32-MEM defines SIA-TSO and one architectural full data-memory FENCE.
;; Cranelift's generic fence therefore maps directly to that instruction.
(rule (lower (fence))
      (side_effect (SideEffectNoResult.Inst (sia_fence))))


;;;; Conditional traps ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(rule (lower (trapnz value code))
      (let ((test Reg (put_in_reg value)))
        (side_effect (SideEffectNoResult.Inst (MInst.TrapIfNz test code)))))
(rule (lower (trapz value code))
      (let ((test Reg (put_in_reg value)))
        (side_effect (SideEffectNoResult.Inst (MInst.TrapIfZ test code)))))


;;;; Checked unsigned addition ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(rule (lower (uadd_overflow $I32 x y))
      (let ((lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y))
            (sum WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_add sum lhs rhs)))
            (overflow WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_cmpltu overflow (writable_reg_to_reg sum) lhs))))
        (output_pair (writable_reg_to_reg sum) (writable_reg_to_reg overflow))))


;;;; Integer comparisons ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(decl rec sia_icmp_result (IntCC Value Value) InstOutput)
(rule (sia_icmp_result (IntCC.Equal) x y)
      (let ((dst WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_cmpeq dst lhs rhs) dst)))
(rule (sia_icmp_result (IntCC.NotEqual) x y)
      (let ((eq WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y))
            (_ Unit (emit (sia_cmpeq eq lhs rhs))) (one WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_load_const one 1))) (dst WritableReg (temp_writable_reg $I32)))
        (sia_emit_result (sia_xor dst (writable_reg_to_reg eq) (writable_reg_to_reg one)) dst)))
(rule (sia_icmp_result (IntCC.SignedLessThan) x y)
      (let ((dst WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_cmplt dst lhs rhs) dst)))
(rule (sia_icmp_result (IntCC.UnsignedLessThan) x y)
      (let ((dst WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_cmpltu dst lhs rhs) dst)))
(rule (sia_icmp_result (IntCC.SignedGreaterThan) x y) (sia_icmp_result (IntCC.SignedLessThan) y x))
(rule (sia_icmp_result (IntCC.UnsignedGreaterThan) x y) (sia_icmp_result (IntCC.UnsignedLessThan) y x))
(rule (sia_icmp_result (IntCC.SignedGreaterThanOrEqual) x y)
      (sia_icmp_result (IntCC.SignedLessThanOrEqual) y x))
(rule (sia_icmp_result (IntCC.UnsignedGreaterThanOrEqual) x y)
      (sia_icmp_result (IntCC.UnsignedLessThanOrEqual) y x))
(rule (sia_icmp_result (IntCC.SignedLessThanOrEqual) x y)
      (let ((gt WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg y)) (rhs Reg (put_in_reg x))
            (_ Unit (emit (sia_cmplt gt lhs rhs))) (one WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_load_const one 1))) (dst WritableReg (temp_writable_reg $I32)))
        (sia_emit_result (sia_xor dst (writable_reg_to_reg gt) (writable_reg_to_reg one)) dst)))
(rule (sia_icmp_result (IntCC.UnsignedLessThanOrEqual) x y)
      (let ((gt WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg y)) (rhs Reg (put_in_reg x))
            (_ Unit (emit (sia_cmpltu gt lhs rhs))) (one WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_load_const one 1))) (dst WritableReg (temp_writable_reg $I32)))
        (sia_emit_result (sia_xor dst (writable_reg_to_reg gt) (writable_reg_to_reg one)) dst)))
(rule (lower (icmp (fits_in_32 (ty_int _)) cc x y)) (sia_icmp_result cc x y))


;;;; Multiply / divide / remainder ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(rule (lower (imul (fits_in_32 (ty_int _)) x y))
      (let ((dst WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_mul dst lhs rhs) dst)))
(rule (lower (udiv (fits_in_32 (ty_int _)) x y))
      (let ((dst WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_divu dst lhs rhs) dst)))
(rule (lower (sdiv (fits_in_32 (ty_int _)) x y))
      (let ((dst WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_div dst lhs rhs) dst)))
(rule (lower (urem (fits_in_32 (ty_int _)) x y))
      (let ((dst WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_remu dst lhs rhs) dst)))
(rule (lower (srem (fits_in_32 (ty_int _)) x y))
      (let ((dst WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_rem dst lhs rhs) dst)))
