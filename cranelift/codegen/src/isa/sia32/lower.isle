;; Initial SIA32 CLIF-to-MachInst lowering.
;;
;; This deliberately starts with the integer leaf-function core. Unsupported
;; CLIF operations continue to fail through Cranelift's normal "should be
;; implemented in ISLE" path rather than being approximated.

(decl partial lower (Inst) InstOutput)
(decl partial lower_branch (Inst MachLabelSlice) Unit)

;; Emit one result-producing instruction.
(decl sia_emit_result (MInst WritableReg) InstOutput)
(rule (sia_emit_result inst dst)
      (let ((_ Unit (emit inst)))
        (output (value_reg (writable_reg_to_reg dst)))))

;;;; Constants ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (iconst (fits_in_32 (ty_int ty)) (u64_from_imm64 n)))
      (let ((dst WritableReg (temp_writable_reg ty)))
        (sia_emit_result (sia_load_const dst n) dst)))

;;;; Integer ALU ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (iadd (fits_in_32 (ty_int ty)) x y))
      (let ((dst WritableReg (temp_writable_reg ty))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_add dst lhs rhs) dst)))

(rule (lower (isub (fits_in_32 (ty_int ty)) x y))
      (let ((dst WritableReg (temp_writable_reg ty))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_sub dst lhs rhs) dst)))

(rule (lower (ineg (fits_in_32 (ty_int ty)) x))
      (let ((dst WritableReg (temp_writable_reg ty))
            (zero WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_load_const zero 0)))
            (src Reg (put_in_reg x)))
        (sia_emit_result (sia_sub dst (writable_reg_to_reg zero) src) dst)))

(rule (lower (band (fits_in_32 (ty_int ty)) x y))
      (let ((dst WritableReg (temp_writable_reg ty))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_and dst lhs rhs) dst)))

(rule (lower (bor (fits_in_32 (ty_int ty)) x y))
      (let ((dst WritableReg (temp_writable_reg ty))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_or dst lhs rhs) dst)))

(rule (lower (bxor (fits_in_32 (ty_int ty)) x y))
      (let ((dst WritableReg (temp_writable_reg ty))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_xor dst lhs rhs) dst)))

(rule (lower (bnot (fits_in_32 (ty_int ty)) x))
      (let ((dst WritableReg (temp_writable_reg ty))
            (ones WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_load_const ones 4294967295)))
            (src Reg (put_in_reg x)))
        (sia_emit_result (sia_xor dst src (writable_reg_to_reg ones)) dst)))

;; I32 shifts use SIA hardware count masking. Narrow shifts below explicitly
;; mask counts to their width and normalize the operand before shifting.
(rule (lower (ishl $I32 x y))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_shl dst lhs rhs) dst)))

(rule (lower (ushr $I32 x y))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_shr dst lhs rhs) dst)))

(rule (lower (sshr $I32 x y))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_sar dst lhs rhs) dst)))

(rule (lower (clz $I32 x))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (src Reg (put_in_reg x)))
        (sia_emit_result (sia_clz dst src) dst)))

(rule (lower (ctz $I32 x))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (src Reg (put_in_reg x)))
        (sia_emit_result (sia_ctz dst src) dst)))

(rule (lower (popcnt $I32 x))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (src Reg (put_in_reg x)))
        (sia_emit_result (sia_popcnt dst src) dst)))

;;;; Extension / reduction ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl sia_extend_result (Value bool u8) InstOutput)
(rule (sia_extend_result src signed from_bits)
      (let ((dst WritableReg (temp_writable_reg $I32))
            (reg Reg (put_in_reg src)))
        (sia_emit_result (sia_extend dst reg signed from_bits 32) dst)))

(rule (lower (uextend $I32 x @ (value_type $I8)))
      (sia_extend_result x false 8))
(rule (lower (uextend $I32 x @ (value_type $I16)))
      (sia_extend_result x false 16))
(rule (lower (sextend $I32 x @ (value_type $I8)))
      (sia_extend_result x true 8))
(rule (lower (sextend $I32 x @ (value_type $I16)))
      (sia_extend_result x true 16))

;; Reduction needs no machine instruction: the destination observes the low
;; bits of the same 32-bit register representation.
(rule (lower (ireduce $I8 x @ (value_type $I32))) (output_value x))
(rule (lower (ireduce $I16 x @ (value_type $I32))) (output_value x))


;;;; Symbol addresses ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (symbol_value $I32 (symbol_value_data name _ offset)))
      (let ((dst WritableReg (temp_writable_reg $I32)))
        (sia_emit_result (sia_load_ext_name dst (box_external_name name) offset) dst)))

;;;; Dynamic stack allocation ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Runtime allocation grows the SIA32 stack downward. The generic IR operation
;; deliberately hides architectural r13 from language frontends.
(rule (lower (stack_alloc_dynamic $I32 size))
      (let ((saved WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_m_gpr_read saved 13)))
            (amount Reg (put_in_reg size))
            (next WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_sub next (writable_reg_to_reg saved) amount)))
            (_ Unit (emit (sia_m_gpr_write (writable_reg_to_reg next) 13))))
        (output (value_reg (writable_reg_to_reg next)))))

;; Release a prior runtime allocation by moving the architectural stack
;; pointer upward by the same byte count.
(rule (lower (stack_free_dynamic size))
      (let ((saved WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_m_gpr_read saved 13)))
            (amount Reg (put_in_reg size))
            (next WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_add next (writable_reg_to_reg saved) amount))))
        (side_effect (SideEffectNoResult.Inst
          (sia_m_gpr_write (writable_reg_to_reg next) 13)))))

;;;; Stack addresses ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; stack_addr is an ABI pseudo: keep the stack-slot identity until post-regalloc
;; emission, where the finalized frame layout determines the SP-relative offset.
(rule (lower (stack_addr $I32 ss offset))
      (output (value_reg (gen_stack_addr ss offset))))

;;;; Scalar memory ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl sia_load_result (Type Value i32) InstOutput)
(rule (sia_load_result ty addr offset)
      (let ((dst WritableReg (temp_writable_reg ty))
            (base Reg (put_in_reg addr)))
        (sia_emit_result (sia_load_offset dst base offset ty) dst)))

(rule (lower (load (fits_in_32 (ty_int ty)) (little_or_native_endian _) addr (offset32 offset)))
      (sia_load_result ty addr offset))

(rule (lower (store (little_or_native_endian _) src @ (value_type (fits_in_32 (ty_int ty))) addr (offset32 offset)))
      (let ((value Reg (put_in_reg src))
            (base Reg (put_in_reg addr)))
        (side_effect (SideEffectNoResult.Inst (sia_store_offset value base offset ty)))))

;;;; Calls ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (call (func_ref_data sig_ref name _ patchable) args))
      (let ((output ValueRegsVec (gen_call_output sig_ref))
            (abi Sig (abi_sig sig_ref))
            (uses CallArgList (gen_call_args abi args))
            (defs CallRetList (gen_call_rets abi output))
            (info BoxCallInfo (gen_call_info abi name uses defs (try_call_none) patchable))
            (_ Unit (emit_side_effect (call_impl info))))
        output))

(rule (lower (call_indirect sig_ref ptr args))
      (let ((output ValueRegsVec (gen_call_output sig_ref))
            (abi Sig (abi_sig sig_ref))
            (target Reg (put_in_reg ptr))
            (uses CallArgList (gen_call_args abi args))
            (defs CallRetList (gen_call_rets abi output))
            (info BoxCallIndInfo (gen_call_ind_info abi target uses defs (try_call_none)))
            (_ Unit (emit_side_effect (call_ind_impl info))))
        output))


;;;; SIA32-P privileged operations ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(rule (lower (sia_trap (u8_from_uimm8 code)))
      (side_effect (SideEffectNoResult.Inst (sia_m_trap code))))
(rule (lower (sia_gpr_read $I32 (u8_from_uimm8 register)))
      (let ((dst WritableReg (temp_writable_reg $I32)))
        (sia_emit_result (sia_m_gpr_read dst register) dst)))
(rule (lower (sia_gpr_write value (u8_from_uimm8 register)))
      (let ((src Reg (put_in_reg value)))
        (side_effect (SideEffectNoResult.Inst (sia_m_gpr_write src register)))))
(rule (lower (sia_sread $I32 (u8_from_uimm8 selector)))
      (let ((dst WritableReg (temp_writable_reg $I32)))
        (sia_emit_result (sia_m_sread dst selector) dst)))
(rule (lower (sia_swrite value (u8_from_uimm8 selector)))
      (let ((src Reg (put_in_reg value)))
        (side_effect (SideEffectNoResult.Inst (sia_m_swrite src selector)))))
(rule (lower (sia_sret))
      (side_effect (SideEffectNoResult.Inst (sia_m_sret))))
(rule (lower (sia_tlbfence))
      (side_effect (SideEffectNoResult.Inst (sia_m_tlbfence))))
(rule (lower (sia_tlbfence_va value))
      (let ((src Reg (put_in_reg value)))
        (side_effect (SideEffectNoResult.Inst (sia_m_tlbfence_va src)))))
(rule (lower (sia_tlbfence_asid value))
      (let ((src Reg (put_in_reg value)))
        (side_effect (SideEffectNoResult.Inst (sia_m_tlbfence_asid src)))))
(rule (lower (sia_wfi))
      (side_effect (SideEffectNoResult.Inst (sia_m_wfi))))
(rule (lower (sia_sync_i))
      (side_effect (SideEffectNoResult.Inst (sia_m_sync_i))))

;;;; Return and control flow ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; The ABI generates the Rets pseudo and architectural RET.
(rule (lower (return args))
      (lower_return args))

(rule (lower_branch (jump _) (single_target target))
      (emit_side_effect (SideEffectNoResult.Inst (sia_jump target))))

(rule (lower_branch (brif cond _ _) (two_targets taken not_taken))
      (let ((test Reg (sia_trap_test cond)))
        (emit_side_effect (SideEffectNoResult.Inst (sia_brnz test taken not_taken)))))

;; SIA32-MEM defines SIA-TSO and one architectural full data-memory FENCE.
;; Cranelift's generic fence therefore maps directly to that instruction.
(rule (lower (fence))
      (side_effect (SideEffectNoResult.Inst (sia_fence))))


;;;; Generic compiler faults (distinct from architectural sia_trap).
(rule (lower (trap code))
      (side_effect (SideEffectNoResult.Inst (MInst.Udf code))))

(decl partial sia_trap_test (Value) Reg)
(rule (sia_trap_test value @ (value_type $I32)) (put_in_reg value))
(rule (sia_trap_test value @ (value_type $I8))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_extend dst (put_in_reg value) false 8 32))))
        (writable_reg_to_reg dst)))
(rule (sia_trap_test value @ (value_type $I16))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_extend dst (put_in_reg value) false 16 32))))
        (writable_reg_to_reg dst)))
(rule (sia_trap_test value @ (value_type $I64))
      (let ((parts ValueRegs (put_in_regs value))
            (dst WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_or dst (value_regs_get parts 0) (value_regs_get parts 1)))))
        (writable_reg_to_reg dst)))

;;;; Conditional traps ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(rule (lower (trapnz value code))
      (let ((test Reg (sia_trap_test value)))
        (side_effect (SideEffectNoResult.Inst (MInst.TrapIfNz test code)))))
(rule (lower (trapz value code))
      (let ((test Reg (sia_trap_test value)))
        (side_effect (SideEffectNoResult.Inst (MInst.TrapIfZ test code)))))


;;;; Checked unsigned addition ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(rule (lower (uadd_overflow $I32 x y))
      (let ((lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y))
            (sum WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_add sum lhs rhs)))
            (overflow WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_cmpltu overflow (writable_reg_to_reg sum) lhs))))
        (output_pair (writable_reg_to_reg sum) (writable_reg_to_reg overflow))))


;;;; Integer comparisons ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(rule (lower (icmp _ cc x @ (value_type (fits_in_32 (ty_int _))) y))
      (let ((dst WritableReg (temp_writable_reg $I32))
            (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_icmp dst cc lhs rhs) dst)))

;;;; Multiply / divide / remainder ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(rule (lower (imul (fits_in_32 (ty_int _)) x y))
      (let ((dst WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_mul dst lhs rhs) dst)))
(rule (lower (udiv (fits_in_32 (ty_int _)) x y))
      (let ((dst WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_divu dst lhs rhs) dst)))
(rule (lower (sdiv (fits_in_32 (ty_int _)) x y))
      (let ((dst WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_div dst lhs rhs) dst)))
(rule (lower (urem (fits_in_32 (ty_int _)) x y))
      (let ((dst WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_remu dst lhs rhs) dst)))
(rule (lower (srem (fits_in_32 (ty_int _)) x y))
      (let ((dst WritableReg (temp_writable_reg $I32)) (lhs Reg (put_in_reg x)) (rhs Reg (put_in_reg y)))
        (sia_emit_result (sia_rem dst lhs rhs) dst)))

;;;; Native I64 word-pair core ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(decl sia_i64_const (u64) ValueRegs)
(extern constructor sia_i64_const sia_i64_const)
(decl sia_i64_alu (ValueRegs ValueRegs u8) ValueRegs)
(extern constructor sia_i64_alu sia_i64_alu)
(decl sia_i64_extend (Reg bool u8) ValueRegs)
(extern constructor sia_i64_extend sia_i64_extend)
(rule 1 (lower (iconst $I64 (u64_from_imm64 n))) (output (sia_i64_const n)))
(rule 1 (lower (iadd $I64 x y)) (output (sia_i64_alu (put_in_regs x) (put_in_regs y) 0)))
(rule 1 (lower (isub $I64 x y)) (output (sia_i64_alu (put_in_regs x) (put_in_regs y) 1)))
(rule 1 (lower (band $I64 x y)) (output (sia_i64_alu (put_in_regs x) (put_in_regs y) 2)))
(rule 1 (lower (bor $I64 x y)) (output (sia_i64_alu (put_in_regs x) (put_in_regs y) 3)))
(rule 1 (lower (bxor $I64 x y)) (output (sia_i64_alu (put_in_regs x) (put_in_regs y) 4)))
(rule 1 (lower (uextend $I64 x @ (value_type $I8))) (output (sia_i64_extend (put_in_reg x) false 8)))
(rule 1 (lower (uextend $I64 x @ (value_type $I16))) (output (sia_i64_extend (put_in_reg x) false 16)))
(rule 1 (lower (uextend $I64 x @ (value_type $I32))) (output (sia_i64_extend (put_in_reg x) false 32)))
(rule 1 (lower (sextend $I64 x @ (value_type $I8))) (output (sia_i64_extend (put_in_reg x) true 8)))
(rule 1 (lower (sextend $I64 x @ (value_type $I16))) (output (sia_i64_extend (put_in_reg x) true 16)))
(rule 1 (lower (sextend $I64 x @ (value_type $I32))) (output (sia_i64_extend (put_in_reg x) true 32)))
(rule 1 (lower (ireduce $I8 x @ (value_type $I64))) (output (value_reg (value_regs_get (put_in_regs x) 0))))
(rule 1 (lower (ireduce $I16 x @ (value_type $I64))) (output (value_reg (value_regs_get (put_in_regs x) 0))))
(rule 1 (lower (ireduce $I32 x @ (value_type $I64))) (output (value_reg (value_regs_get (put_in_regs x) 0))))

(decl sia_i64_variable_shift (ValueRegs ValueRegs u8) ValueRegs)
(extern constructor sia_i64_variable_shift sia_i64_variable_shift)
(rule 1 (lower (ishl $I64 x y)) (output (sia_i64_variable_shift (put_in_regs x) (put_in_regs y) 0)))
(rule 1 (lower (ushr $I64 x y)) (output (sia_i64_variable_shift (put_in_regs x) (put_in_regs y) 1)))
(rule 1 (lower (sshr $I64 x y)) (output (sia_i64_variable_shift (put_in_regs x) (put_in_regs y) 2)))

(decl sia_i64_shift (ValueRegs u64 u8) ValueRegs)
(extern constructor sia_i64_shift sia_i64_shift)
(rule 2 (lower (ishl $I64 x (u64_from_iconst amount))) (output (sia_i64_shift (put_in_regs x) amount 0)))
(rule 2 (lower (ushr $I64 x (u64_from_iconst amount))) (output (sia_i64_shift (put_in_regs x) amount 1)))
(rule 2 (lower (sshr $I64 x (u64_from_iconst amount))) (output (sia_i64_shift (put_in_regs x) amount 2)))
(rule 3 (lower (ishl $I64 x (sextend $I64 (u64_from_iconst amount)))) (output (sia_i64_shift (put_in_regs x) amount 0)))
(rule 3 (lower (ishl $I64 x (uextend $I64 (u64_from_iconst amount)))) (output (sia_i64_shift (put_in_regs x) amount 0)))
(rule 3 (lower (ushr $I64 x (sextend $I64 (u64_from_iconst amount)))) (output (sia_i64_shift (put_in_regs x) amount 1)))
(rule 3 (lower (ushr $I64 x (uextend $I64 (u64_from_iconst amount)))) (output (sia_i64_shift (put_in_regs x) amount 1)))
(rule 3 (lower (sshr $I64 x (sextend $I64 (u64_from_iconst amount)))) (output (sia_i64_shift (put_in_regs x) amount 2)))
(rule 3 (lower (sshr $I64 x (uextend $I64 (u64_from_iconst amount)))) (output (sia_i64_shift (put_in_regs x) amount 2)))

(decl sia_i64_load (Reg i32) ValueRegs)
(extern constructor sia_i64_load sia_i64_load)
(decl sia_i64_store (ValueRegs Reg i32) InstOutput)
(extern constructor sia_i64_store sia_i64_store)
(decl sia_i64_icmp (ValueRegs ValueRegs IntCC) Reg)
(extern constructor sia_i64_icmp sia_i64_icmp)
(rule 1 (lower (load $I64 (little_or_native_endian _) addr (offset32 offset)))
      (output (sia_i64_load (put_in_reg addr) offset)))
(rule 1 (lower (store (little_or_native_endian _) src @ (value_type $I64) addr (offset32 offset)))
      (sia_i64_store (put_in_regs src) (put_in_reg addr) offset))
(rule 1 (lower (icmp _ cc x @ (value_type $I64) y))
      (output (value_reg (sia_i64_icmp (put_in_regs x) (put_in_regs y) cc))))

(decl sia_i64_mul (ValueRegs ValueRegs) ValueRegs)
(extern constructor sia_i64_mul sia_i64_mul)
(rule 1 (lower (imul $I64 x y)) (output (sia_i64_mul (put_in_regs x) (put_in_regs y))))

(decl sia_br_table (Reg MachLabelSlice) Unit)
(extern constructor sia_br_table sia_br_table)
(rule (lower_branch (br_table index _) targets)
      (sia_br_table (put_in_reg index) targets))

(decl sia_select (Reg Reg Reg) Reg)
(extern constructor sia_select sia_select)
(rule (lower (select (fits_in_32 (ty_int ty)) c x y))
      (output (sia_select (sia_trap_test c) (put_in_reg x) (put_in_reg y))))
(decl sia_narrow_shift (Reg Reg u8 u8) Reg)
(extern constructor sia_narrow_shift sia_narrow_shift)
(rule (lower (ishl $I8 x y)) (output (sia_narrow_shift (put_in_reg x) (put_in_reg y) 8 0)))
(rule (lower (ushr $I8 x y)) (output (sia_narrow_shift (put_in_reg x) (put_in_reg y) 8 1)))
(rule (lower (sshr $I8 x y)) (output (sia_narrow_shift (put_in_reg x) (put_in_reg y) 8 2)))
(rule (lower (ishl $I16 x y)) (output (sia_narrow_shift (put_in_reg x) (put_in_reg y) 16 0)))
(rule (lower (ushr $I16 x y)) (output (sia_narrow_shift (put_in_reg x) (put_in_reg y) 16 1)))
(rule (lower (sshr $I16 x y)) (output (sia_narrow_shift (put_in_reg x) (put_in_reg y) 16 2)))

(decl sia_umulhi (Reg Reg) Reg)
(extern constructor sia_umulhi sia_umulhi)
(rule (lower (umulhi $I32 x y)) (output (sia_umulhi (put_in_reg x) (put_in_reg y))))

(rule (lower (umin $I32 x y))
      (let ((lhs Reg (put_in_reg x))
            (rhs Reg (put_in_reg y))
            (condition WritableReg (temp_writable_reg $I32))
            (_ Unit (emit (sia_icmp condition (IntCC.UnsignedLessThan) lhs rhs))))
        (output (sia_select (writable_reg_to_reg condition) lhs rhs))))

(decl sia_i64_umulhi (ValueRegs ValueRegs) ValueRegs)
(extern constructor sia_i64_umulhi sia_i64_umulhi)
(rule (lower (umulhi $I64 x y))
      (output (sia_i64_umulhi (put_in_regs x) (put_in_regs y))))

(decl sia_i64_bitcount (ValueRegs u8) ValueRegs)
(extern constructor sia_i64_bitcount sia_i64_bitcount)
(rule (lower (clz $I64 x)) (output (sia_i64_bitcount (put_in_regs x) 0)))
(rule (lower (ctz $I64 x)) (output (sia_i64_bitcount (put_in_regs x) 1)))
(rule (lower (popcnt $I64 x)) (output (sia_i64_bitcount (put_in_regs x) 2)))

(rule (lower (func_addr $I32 (func_ref_data _ name _ _)))
      (let ((dst WritableReg (temp_writable_reg $I32)))
        (sia_emit_result (sia_load_ext_name dst (box_external_name name) 0) dst)))
