;; SIA32 machine-instruction constructors exposed to ISLE.
;;
;; Keep this as an ISLE enum rather than an opaque primitive. ISLE primitives
;; are required to be Copy, while the authoritative Rust MachineInst contains
;; Vec/Box variants and is intentionally not Copy. The lowering glue converts
;; this small R0-facing enum into the existing Rust MachineInst at emit time.

;; StackAMode itself is a small copyable ABI descriptor from MachInst and is
;; legitimately opaque to the SIA selection rules.
(type StackAMode (primitive StackAMode))
(type BoxCallInfo (primitive BoxCallInfo))
(type BoxCallIndInfo (primitive BoxCallIndInfo))

(type MInst
  (enum
    (Mov
      (dst WritableReg)
      (src Reg))
    (StackAddr
      (dst WritableReg)
      (mem StackAMode))
    (LoadConst32
      (dst WritableReg)
      (value u32))
    (Add
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (CmpEq (dst WritableReg) (lhs Reg) (rhs Reg))
    (CmpLt (dst WritableReg) (lhs Reg) (rhs Reg))
    (CmpLtu
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Sub
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (And
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Or
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Xor
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Mul (dst WritableReg) (lhs Reg) (rhs Reg))
    (Div (dst WritableReg) (lhs Reg) (rhs Reg))
    (DivU (dst WritableReg) (lhs Reg) (rhs Reg))
    (Rem (dst WritableReg) (lhs Reg) (rhs Reg))
    (RemU (dst WritableReg) (lhs Reg) (rhs Reg))
    (Shl
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Shr
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Sar
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Clz
      (dst WritableReg)
      (src Reg))
    (Ctz
      (dst WritableReg)
      (src Reg))
    (Cpop
      (dst WritableReg)
      (src Reg))
    (Extend
      (dst WritableReg)
      (src Reg)
      (signed bool)
      (from_bits u8)
      (to_bits u8))
    (LoadBaseOffset
      (dst WritableReg)
      (base Reg)
      (offset i32)
      (ty Type))
    (StoreBaseOffset
      (src Reg)
      (base Reg)
      (offset i32)
      (ty Type))
    (Fence)
    (SRead (dst WritableReg) (selector u8))
    (SWrite (src Reg) (selector u8))
    (ReadFixedGpr (dst WritableReg) (index u8))
    (WriteFixedGpr (src Reg) (index u8))
    (SRet)
    (TlbFence)
    (TlbFenceVa (src Reg))
    (TlbFenceAsid (src Reg))
    (Wfi)
    (SyncI)
    (SoftwareTrap (code u8))
    (TrapIfNz (test Reg) (code TrapCode))
    (TrapIfZ (test Reg) (code TrapCode))
    (Call (info BoxCallInfo))
    (CallInd (info BoxCallIndInfo))
    (Jump
      (target MachLabel))
    (BrNz
      (test Reg)
      (taken MachLabel)
      (not_taken MachLabel))))

(decl gen_stack_addr (StackSlot Offset32) Reg)
(extern constructor gen_stack_addr gen_stack_addr)
(decl sia_load_const (WritableReg u64) MInst)
(extern constructor sia_load_const sia_load_const)
(decl sia_add (WritableReg Reg Reg) MInst)
(decl sia_cmpeq (WritableReg Reg Reg) MInst)
(extern constructor sia_cmpeq sia_cmpeq)
(decl sia_cmplt (WritableReg Reg Reg) MInst)
(extern constructor sia_cmplt sia_cmplt)
(decl sia_cmpltu (WritableReg Reg Reg) MInst)
(extern constructor sia_cmpltu sia_cmpltu)
(extern constructor sia_add sia_add)
(decl sia_sub (WritableReg Reg Reg) MInst)
(extern constructor sia_sub sia_sub)
(decl sia_and (WritableReg Reg Reg) MInst)
(extern constructor sia_and sia_and)
(decl sia_or (WritableReg Reg Reg) MInst)
(extern constructor sia_or sia_or)
(decl sia_xor (WritableReg Reg Reg) MInst)
(extern constructor sia_xor sia_xor)
(decl sia_mul (WritableReg Reg Reg) MInst)
(extern constructor sia_mul sia_mul)
(decl sia_div (WritableReg Reg Reg) MInst)
(extern constructor sia_div sia_div)
(decl sia_divu (WritableReg Reg Reg) MInst)
(extern constructor sia_divu sia_divu)
(decl sia_rem (WritableReg Reg Reg) MInst)
(extern constructor sia_rem sia_rem)
(decl sia_remu (WritableReg Reg Reg) MInst)
(extern constructor sia_remu sia_remu)
(decl sia_shl (WritableReg Reg Reg) MInst)
(extern constructor sia_shl sia_shl)
(decl sia_shr (WritableReg Reg Reg) MInst)
(extern constructor sia_shr sia_shr)
(decl sia_sar (WritableReg Reg Reg) MInst)
(extern constructor sia_sar sia_sar)
(decl sia_clz (WritableReg Reg) MInst)
(extern constructor sia_clz sia_clz)
(decl sia_ctz (WritableReg Reg) MInst)
(extern constructor sia_ctz sia_ctz)
(decl sia_popcnt (WritableReg Reg) MInst)
(extern constructor sia_popcnt sia_popcnt)
(decl sia_extend (WritableReg Reg bool u8 u8) MInst)
(extern constructor sia_extend sia_extend)
(decl sia_load_offset (WritableReg Reg i32 Type) MInst)
(extern constructor sia_load_offset sia_load_offset)
(decl sia_store_offset (Reg Reg i32 Type) MInst)
(extern constructor sia_store_offset sia_store_offset)
(decl sia_m_sread (WritableReg u8) MInst)
(extern constructor sia_m_sread sia_m_sread)
(decl sia_m_swrite (Reg u8) MInst)
(extern constructor sia_m_swrite sia_m_swrite)
(decl sia_m_gpr_read (WritableReg u8) MInst)
(extern constructor sia_m_gpr_read sia_m_gpr_read)
(decl sia_m_gpr_write (Reg u8) MInst)
(extern constructor sia_m_gpr_write sia_m_gpr_write)
(decl sia_m_sret () MInst)
(extern constructor sia_m_sret sia_m_sret)
(decl sia_m_tlbfence () MInst)
(extern constructor sia_m_tlbfence sia_m_tlbfence)
(decl sia_m_tlbfence_va (Reg) MInst)
(extern constructor sia_m_tlbfence_va sia_m_tlbfence_va)
(decl sia_m_tlbfence_asid (Reg) MInst)
(extern constructor sia_m_tlbfence_asid sia_m_tlbfence_asid)
(decl sia_m_wfi () MInst)
(extern constructor sia_m_wfi sia_m_wfi)
(decl sia_m_sync_i () MInst)
(extern constructor sia_m_sync_i sia_m_sync_i)
(decl sia_m_trap (u8) MInst)
(extern constructor sia_m_trap sia_m_trap)
(decl sia_fence () MInst)
(extern constructor sia_fence sia_fence)
(decl sia_jump (MachLabel) MInst)
(extern constructor sia_jump sia_jump)
(decl sia_brnz (Reg MachLabel MachLabel) MInst)
(extern constructor sia_brnz sia_brnz)


;;;; Calls ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(decl gen_call_info (Sig ExternalName CallArgList CallRetList OptionTryCallInfo bool) BoxCallInfo)
(extern constructor gen_call_info gen_call_info)
(decl gen_call_ind_info (Sig Reg CallArgList CallRetList OptionTryCallInfo) BoxCallIndInfo)
(extern constructor gen_call_ind_info gen_call_ind_info)
(decl call_impl (BoxCallInfo) SideEffectNoResult)
(rule (call_impl info) (SideEffectNoResult.Inst (MInst.Call info)))
(decl call_ind_impl (BoxCallIndInfo) SideEffectNoResult)
(rule (call_ind_impl info) (SideEffectNoResult.Inst (MInst.CallInd info)))
