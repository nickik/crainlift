;; SIA32 machine-instruction constructors exposed to ISLE.
;;
;; Keep this as an ISLE enum rather than an opaque primitive. ISLE primitives
;; are required to be Copy, while the authoritative Rust MachineInst contains
;; Vec/Box variants and is intentionally not Copy. The lowering glue converts
;; this small R0-facing enum into the existing Rust MachineInst at emit time.

(type MInst
  (enum
    (LoadConst32
      (dst WritableReg)
      (value u32))
    (Add
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Sub
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (And
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Or
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Xor
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Shl
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Shr
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Sar
      (dst WritableReg)
      (lhs Reg)
      (rhs Reg))
    (Clz
      (dst WritableReg)
      (src Reg))
    (Ctz
      (dst WritableReg)
      (src Reg))
    (Cpop
      (dst WritableReg)
      (src Reg))
    (Extend
      (dst WritableReg)
      (src Reg)
      (signed bool)
      (from_bits u8)
      (to_bits u8))
    (LoadBaseOffset
      (dst WritableReg)
      (base Reg)
      (offset i32)
      (ty Type))
    (StoreBaseOffset
      (src Reg)
      (base Reg)
      (offset i32)
      (ty Type))
    (Jump
      (target MachLabel))
    (BrNz
      (test Reg)
      (taken MachLabel)
      (not_taken MachLabel))))

(decl sia_load_const (WritableReg u64) MInst)
(extern constructor sia_load_const sia_load_const)

(decl sia_add (WritableReg Reg Reg) MInst)
(extern constructor sia_add sia_add)
(decl sia_sub (WritableReg Reg Reg) MInst)
(extern constructor sia_sub sia_sub)
(decl sia_and (WritableReg Reg Reg) MInst)
(extern constructor sia_and sia_and)
(decl sia_or (WritableReg Reg Reg) MInst)
(extern constructor sia_or sia_or)
(decl sia_xor (WritableReg Reg Reg) MInst)
(extern constructor sia_xor sia_xor)
(decl sia_shl (WritableReg Reg Reg) MInst)
(extern constructor sia_shl sia_shl)
(decl sia_shr (WritableReg Reg Reg) MInst)
(extern constructor sia_shr sia_shr)
(decl sia_sar (WritableReg Reg Reg) MInst)
(extern constructor sia_sar sia_sar)

(decl sia_clz (WritableReg Reg) MInst)
(extern constructor sia_clz sia_clz)
(decl sia_ctz (WritableReg Reg) MInst)
(extern constructor sia_ctz sia_ctz)
(decl sia_popcnt (WritableReg Reg) MInst)
(extern constructor sia_popcnt sia_popcnt)

(decl sia_extend (WritableReg Reg bool u8 u8) MInst)
(extern constructor sia_extend sia_extend)

(decl sia_load_offset (WritableReg Reg i32 Type) MInst)
(extern constructor sia_load_offset sia_load_offset)
(decl sia_store_offset (Reg Reg i32 Type) MInst)
(extern constructor sia_store_offset sia_store_offset)

(decl sia_jump (MachLabel) MInst)
(extern constructor sia_jump sia_jump)
(decl sia_brnz (Reg MachLabel MachLabel) MInst)
(extern constructor sia_brnz sia_brnz)
